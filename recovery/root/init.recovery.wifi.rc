# PHY110 Wi-Fi: load the device services and prepare the CNSS driver after decryption.
on property:post.decrypt.modules=true && property:ro.recovery.phy110.supported=1
    setprop sys.aera.wlan.up 0
    setprop wifi.driver.ready false
    chmod 0222 /sys/devices/platform/soc/b0000000.qcom,cnss-kiwi/fs_ready
    write /sys/devices/platform/soc/b0000000.qcom,cnss-kiwi/fs_ready 1
    start aera-wlan-ready

on property:wifi.driver.ready=true && property:ro.recovery.phy110.supported=1
    mkdir /tmp/recovery 0771 root wifi
    mkdir /tmp/recovery/sockets 0770 wifi wifi
    chown wifi wifi /tmp/recovery/sockets
    chmod 0770 /tmp/recovery/sockets
    start wpa_supplicant

on property:sys.aera.wlan.up=1 && property:wifi.driver.ready=true && property:ro.recovery.phy110.supported=1
    setprop sys.aera.wlan.up 0
    mkdir /tmp/recovery 0771 root wifi
    mkdir /tmp/recovery/sockets 0770 wifi wifi
    chown wifi wifi /tmp/recovery/sockets
    chmod 0770 /tmp/recovery/sockets
    start wpa_supplicant

service wpa_supplicant /system/bin/wpa_supplicant -Dnl80211 -iwlan0 -O/tmp/recovery/sockets -c/vendor/etc/wifi/wpa_supplicant.conf
    disabled
    user root
    group root wifi inet
    seclabel u:r:recovery:s0

service aera-wlan-ready /system/bin/sh /vendor/bin/phy110-wlan-ready.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
