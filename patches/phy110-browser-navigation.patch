--- a/aeraui/features/browser/runtime.cpp
+++ b/aeraui/features/browser/runtime.cpp
@@ -354,6 +354,59 @@ void PreparePluginRuntime(Preparation &state, const char *id,
   state.error.clear();
 }
 
+// This asset is supplied by the PHY110 image. Apply it only to the exact
+// signed engine release that rejects user-activated new-window links. The
+// installed payload remains untouched; extraction and both payload hashes
+// must pass before this root-owned image component can replace its worker.
+static bool CopyVerifiedImageAsset(int root, const char *asset, const char *destination,
+    const char *expected_hash, size_t limit, mode_t mode) {
+  FD source(open(asset, O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+  if (source.value < 0) return errno == ENOENT;
+  struct stat info{};
+  if (fstat(source.value, &info) || !S_ISREG(info.st_mode) || info.st_uid ||
+      (info.st_mode & 0022) || info.st_size <= 0 || static_cast<uint64_t>(info.st_size) > limit) return false;
+  std::vector<unsigned char> bytes(static_cast<size_t>(info.st_size));
+  size_t position = 0;
+  while (position < bytes.size()) {
+    ssize_t count = read(source.value, bytes.data() + position, bytes.size() - position);
+    if (count < 0 && errno == EINTR) continue;
+    if (count <= 0) return false;
+    position += static_cast<size_t>(count);
+  }
+  Hash hash; hash.Add(bytes.data(), bytes.size());
+  if (!hash.Matches(expected_hash)) return false;
+  if (!PathSafe(destination)) return false;
+  FD directory(Parent(root, destination));
+  if (directory.value < 0) return false;
+  const std::string leaf = std::string(destination).substr(std::string(destination).find_last_of('/') + 1);
+  const std::string temporary = leaf + ".phy110-new";
+  FD output(openat(directory.value, temporary.c_str(), O_WRONLY | O_CREAT |
+                   O_EXCL | O_NOFOLLOW | O_CLOEXEC, mode));
+  if (output.value < 0) return false;
+  position = 0;
+  while (position < bytes.size()) {
+    ssize_t count = write(output.value, bytes.data() + position, bytes.size() - position);
+    if (count < 0 && errno == EINTR) continue;
+    if (count <= 0) return false;
+    position += static_cast<size_t>(count);
+  }
+  return !fchmod(output.value, mode) &&
+      !renameat(directory.value, temporary.c_str(), directory.value, leaf.c_str());
+}
+static bool ApplyPhy110BrowserCompatibility(int root, const RuntimeSpec &spec,
+    const char *asset = "/system/etc/aera-browser/phy110-worker") {
+  if (spec.compressed_hash !=
+      "4e3941bd2bcbcc53e4d1bdc7641e7d7c7b16b848b8ba21bb934119118b37f197") return true;
+  return CopyVerifiedImageAsset(root, asset, "usr/bin/aera-browser-worker",
+      "3e5e3134b67513bfa6104641e653e41b3dbab68c2c921617183c2fa51d13faea", 128 * 1024, 0755) &&
+      CopyVerifiedImageAsset(root, "/system/etc/aera-browser/phy110-diagnostics",
+      "etc/phy110-browser-diagnostics",
+      "e056a35db086947e2f5969d747f0a7517bff00c7ffff1f9e7b47b72bfac9d948", 128, 0444) &&
+      CopyVerifiedImageAsset(root, "/twres/fonts/wqy-microhei.ttf",
+      "usr/share/fonts/aera/PHY110-CJK.ttf",
+      "272435f569f3e7ffa7cea299d0b175346738b5922eccaedb168eadb63f8123da", 8 * 1024 * 1024, 0644);
+}
+
 void PrepareRuntime(Preparation &state, const char *payload, const char *parent) {
   // RAII publishes completion even on a normal early return. No worker touches LVGL.
   struct Completion { Preparation &s; ~Completion() { s.done.store(true, std::memory_order_release); } } done{state};
@@ -422,6 +475,11 @@ void PrepareRuntime(Preparation &state, const char *payload, const char *parent)
   }
   // Publish only the complete verified tree. Ownership is still recovery root;
   // only the fixed userspace jail may execute programs from it.
+  if (!ApplyPhy110BrowserCompatibility(root.value, spec)) {
+    RemoveRuntime(temporary);
+    state.error = "PHY110 browser compatibility component failed verification.";
+    return;
+  }
   state.directory = temporary; state.verified = true; state.error.clear();
 }
 
